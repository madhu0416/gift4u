rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Homepage content is public-read for the storefront.
    // Admin write access will be added with authenticated admin claims
    // when the Admin/CMS phase is implemented.
    match /homepage_sections/{sectionId} {
      allow read: if resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    // Wedding, Occasions, Anniversary, Hampers, Personalised, Lifestyle landing pages.
    // Same pattern as homepage_sections: public read of active docs only,
    // no client writes until admin auth is wired in.
    match /category_pages/{pageId} {
      allow read: if resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
